# ========================================================
# ShopSphere Platform Environment Variables Template
# ========================================================

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MULTIPLE_DATABASES=user_db,product_db,inventory_db,order_db,payment_db,notification_db

# Redis Caching & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_UI_PORT=8090

# Observability
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans

# Security & Secrets
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000          # 15 minutes
REFRESH_EXPIRATION_MS=604800000     # 7 days
