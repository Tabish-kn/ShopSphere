  "liveNow": false,
  "panels": [
    {
      "title": "Gateway Request Throughput (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"api-gateway\"}[1m]))",
          "legendFormat": "Throughput"
        }
      ]
    },
    {
      "title": "HTTP 5xx Server Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (application)",
          "legendFormat": "{{application}} 5xx"
        }
      ]
    },
    {
      "title": "Business KPIs: Orders Placed vs Payments Confirmed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(shopsphere_orders_placed_total[1m]))",
          "legendFormat": "Orders Placed / sec"
        },
        {
          "expr": "sum(rate(shopsphere_payments_success_total[1m]))",
          "legendFormat": "Payments Success / sec"
        }
      ]
    },
    {
      "title": "JVM Heap Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application) / 1024 / 1024",
          "legendFormat": "{{application}} Heap (MB)"
        }
      ]
    }
  ],
  "refresh": "5s",
